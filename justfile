# Recipes for the example deployment (spec §13.6). Requires just, OpenTofu 1.13.1,
# the pinned Rust toolchain, worker-build 0.8.7, Node (and wrangler 4.130.0 for
# `local`), openssl and curl.
#
# Secrets never appear on a command line or in output:
#   CLOUDFLARE_API_TOKEN  from your environment (never read from a file here)
#   .demo/admin_token     generated by `up` (openssl rand), passed as TF_VAR_admin_token
#   .demo/state_passphrase generated by `up`, encrypts OpenTofu state (infra/encryption.tf)

set shell := ["bash", "-euo", "pipefail", "-c"]

root := justfile_directory()
bundle_dir := root / "build/worker"
demo_dir := root / ".demo"
infra := root / "infra"
demo_bin := root / "target/release/iroh-do-chat"
# Signs the native binary before running it so the macOS firewall does not prompt.
run := root / "scripts/macos-sign-run.sh"
local_port := env_var_or_default("LOCAL_PORT", "8787")
wrangler_version := "4.130.0"

export WRANGLER_SEND_METRICS := "false"

# List recipes.
default:
    @just --list --unsorted

# Build the demo CLI and the Worker bundle; print the bundle hash and size.
build: build-demo build-worker bundle-info

# Native peer CLI (stock iroh, default features).
build-demo:
    cargo build --release -p iroh-do-demo

# On macOS, ring must be built with Homebrew LLVM's clang and llvm-ar: Apple's ar
# writes empty wasm32 archives. See crates/iroh-do-worker/BUILD.md.
#
# Worker bundle (router + Durable Object class) into build/worker/ via worker-build.
build-worker:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "$(uname -s)" = "Darwin" ]; then
        llvm="${LLVM_PREFIX:-$(brew --prefix llvm 2>/dev/null || echo /opt/homebrew/opt/llvm)}"
        [ -x "$llvm/bin/llvm-ar" ] || { echo "error: brew install llvm (clang + llvm-ar are required for wasm32)" >&2; exit 1; }
    fi
    exec "{{root}}/crates/iroh-do-worker/build-worker.sh"

# Print the bundle's content address (same value as the BUNDLE_SHA256 binding) and sizes.
bundle-info:
    #!/usr/bin/env bash
    set -euo pipefail
    js="{{bundle_dir}}/index.js"; wasm="{{bundle_dir}}/index_bg.wasm"
    [ -f "$js" ] && [ -f "$wasm" ] || { echo "error: no bundle in {{bundle_dir}}; run just build" >&2; exit 1; }
    h() { shasum -a 256 "$1" | cut -d' ' -f1; }
    bundle=$(printf '%s%s' "$(h "$js")" "$(h "$wasm")" | shasum -a 256 | cut -d' ' -f1)
    size() { wc -c < "$1" | tr -d ' '; }
    echo "bundle sha256:  $bundle"
    echo "index.js:       $(size "$js") B"
    echo "index_bg.wasm:  $(size "$wasm") B raw, $(gzip -9c "$wasm" | wc -c | tr -d ' ') B gzip -9 (limit: 64 MiB uncompressed)"

# Build, apply infra/ with OpenTofu, and wait until the wildcard certificate serves.
up: build
    #!/usr/bin/env bash
    set -euo pipefail
    : "${CLOUDFLARE_API_TOKEN:?export CLOUDFLARE_API_TOKEN first (permissions: infra/README.md)}"
    ls "{{infra}}"/*.auto.tfvars >/dev/null 2>&1 || {
        echo "error: copy infra/examples/terraform.tfvars.example to infra/<name>.auto.tfvars and fill it in" >&2; exit 1; }
    mkdir -p "{{demo_dir}}"; chmod 700 "{{demo_dir}}"
    [ -s "{{demo_dir}}/admin_token" ] || (umask 077; openssl rand -hex 32 > "{{demo_dir}}/admin_token")
    [ -s "{{demo_dir}}/state_passphrase" ] || (umask 077; openssl rand -hex 32 > "{{demo_dir}}/state_passphrase")
    export TF_VAR_admin_token="$(cat "{{demo_dir}}/admin_token")"
    export TF_VAR_state_passphrase="$(cat "{{demo_dir}}/state_passphrase")"
    tofu -chdir="{{infra}}" init -input=false
    tofu -chdir="{{infra}}" apply -input=false
    # After a first deploy the live script reports its migration tag, so the
    # config stops sending the migration (see infra/main.tf) and the plan shows
    # it being dropped from state. Converge now, so `just plan` is a zero diff.
    # This re-uploads the same script without a migration; it changes nothing.
    if ! tofu -chdir="{{infra}}" plan -input=false -detailed-exitcode >/dev/null; then
        tofu -chdir="{{infra}}" apply -input=false -auto-approve
    fi
    echo
    echo "endpoint URL template: $(tofu -chdir="{{infra}}" output -raw endpoint_url_template)"
    admin=$(tofu -chdir="{{infra}}" output -raw admin_url)
    echo "admin URL:             $admin"
    echo "waiting for the ACM certificate on $admin (first apply: usually a few minutes)..."
    for i in $(seq 1 90); do
        code=$(curl -s -o /dev/null -w '%{http_code}' -X GET "$admin/mint" || true)
        if [ "$code" != "000" ]; then
            # Record the now-active certificate status in state (no infrastructure
            # change); otherwise the next `just plan` shows it as drift.
            tofu -chdir="{{infra}}" apply -refresh-only -auto-approve -input=false >/dev/null
            echo "TLS OK (GET /mint -> $code). Next: just mint && just demo"; exit 0
        fi
        sleep 10
    done
    echo "certificate not serving yet; check: tofu -chdir=infra output certificate_status" >&2
    exit 1

# Mint an endpoint of app APP (default chat) inside the Worker; write E (never the key) to
# .demo/endpoint. LOCAL=1 mints in `just local-up`'s workerd instead, into .demo/endpoint.local.
mint APP="chat" LABEL="":
    #!/usr/bin/env bash
    set -euo pipefail
    export MINT_APP={{quote(APP)}}
    export MINT_LABEL={{quote(LABEL)}}
    if [ -n "${LOCAL:-}" ]; then
        port="${LOCAL_PORT:-$(cat "{{demo_dir}}/local-up.port" 2>/dev/null || echo 8787)}"
        just _mint "http://admin.localhost:$port" "{{demo_dir}}/admin_token.local" "{{demo_dir}}/endpoint.local" "--resolve admin.localhost:$port:127.0.0.1"
        out="{{demo_dir}}/endpoint.local"; pre="LOCAL=1 "
    else
        export TF_VAR_state_passphrase="$(cat "{{demo_dir}}/state_passphrase")"
        admin=$(tofu -chdir="{{infra}}" output -raw admin_url)
        just _mint "$admin" "{{demo_dir}}/admin_token" "{{demo_dir}}/endpoint"
        out="{{demo_dir}}/endpoint"; pre=""
    fi
    case {{quote(APP)}} in
        chat) echo "join:      ${pre}just chat $(cat "$out")" ;;
        echo) echo "try:       ${pre}just echo $(cat "$out")" ;;
    esac

# Destroy endpoint E: close its sockets, delete its key and history, drop it from the list.
# Cannot be undone. Asks first unless CONFIRM=1. LOCAL=1 targets the local workerd.
destroy-room E:
    #!/usr/bin/env bash
    set -euo pipefail
    e={{quote(E)}}
    [[ "$e" =~ ^[ybndrfg8ejkmcpqxot1uwisza345h769]{52}$ ]] || {
        echo "error: '$e' is not an EndpointId (52 characters of z-base-32)" >&2; exit 1; }
    extra=()
    if [ -n "${LOCAL:-}" ]; then
        port="${LOCAL_PORT:-$(cat "{{demo_dir}}/local-up.port" 2>/dev/null || echo 8787)}"
        admin="http://admin.localhost:$port"
        token="{{demo_dir}}/admin_token.local"
        extra=(--resolve "admin.localhost:$port:127.0.0.1")
    else
        export TF_VAR_state_passphrase="$(cat "{{demo_dir}}/state_passphrase")"
        admin=$(tofu -chdir="{{infra}}" output -raw admin_url)
        token="{{demo_dir}}/admin_token"
    fi
    [ -s "$token" ] || { echo "error: $token missing" >&2; exit 1; }
    if [ "${CONFIRM:-}" != 1 ]; then
        read -r -p "Destroy $e, its key and its history at $admin? This cannot be undone. [y/N] " answer
        [[ "$answer" =~ ^[yY]$ ]] || { echo "aborted"; exit 1; }
    fi
    # Token goes to curl on stdin (-K -), never on argv.
    printf 'header = "Authorization: Bearer %s"\n' "$(cat "$token")" \
        | curl -fsS -K - ${extra[@]+"${extra[@]}"} -X DELETE "$admin/endpoints/$e"
    echo
    for f in "{{demo_dir}}/endpoint" "{{demo_dir}}/endpoint.local"; do
        if [ "$(cat "$f" 2>/dev/null)" = "$e" ]; then rm -f "$f"; fi
    done

# Scripted lifecycle evidence run against the deployed endpoint (extra ARGS go to `lifecycle`).
demo *ARGS: build-demo
    #!/usr/bin/env bash
    set -euo pipefail
    [ -s "{{demo_dir}}/endpoint" ] || { echo "error: no endpoint yet; run just mint" >&2; exit 1; }
    exec "{{run}}" "{{demo_bin}}" lifecycle "$(cat "{{demo_dir}}/endpoint")" {{ARGS}}

# Each nick is a separate member with its own key, so several clients can run
# on one machine. Extra ARGS go to `iroh-do-chat chat` (e.g. --say, --listen-for).
# LOCAL=1 joins a room in `just local-up`'s workerd, on LOCAL_PORT or local-up's port.
#
# Join room E as NICK (default $USER).
[positional-arguments]
chat E NICK=env_var_or_default("USER", "") *ARGS: build-demo
    #!/usr/bin/env bash
    set -euo pipefail
    room="$1"; nick="$2"; shift 2   # positional-arguments keeps each ARG's quoting intact
    [[ "$room" =~ ^[ybndrfg8ejkmcpqxot1uwisza345h769]{52}$ ]] || {
        echo "error: '$room' is not an EndpointId (52 characters of z-base-32); usage: just chat <E> [nick]" >&2; exit 1; }
    net=()
    if [ -n "${LOCAL:-}" ]; then
        # LOCAL_PORT, else the port of a running `just local-up`, else 8787.
        port="${LOCAL_PORT:-$(cat "{{demo_dir}}/local-up.port" 2>/dev/null || echo 8787)}"
        net=(--local --local-port "$port")
    fi
    exec "{{run}}" "{{demo_bin}}" ${net[@]+"${net[@]}"} chat "$room" ${nick:+--nick "$nick"} "$@"

# Echo TEXT off an endpoint minted with the echo app (`just mint echo`), with the stock
# client in apps/echo-client. LOCAL=1 targets `just local-up`'s workerd, as for `just chat`.
echo E TEXT="Hello, world!":
    #!/usr/bin/env bash
    set -euo pipefail
    [[ {{quote(E)}} =~ ^[ybndrfg8ejkmcpqxot1uwisza345h769]{52}$ ]] || {
        echo "error: '{{E}}' is not an EndpointId (52 characters of z-base-32); usage: just echo <E> [text]" >&2; exit 1; }
    cargo build -q -p iroh-do-echo-client
    net=()
    if [ -n "${LOCAL:-}" ]; then
        port="${LOCAL_PORT:-$(cat "{{demo_dir}}/local-up.port" 2>/dev/null || echo 8787)}"
        net=(--local "$port")
    fi
    exec "{{run}}" "{{root}}/target/debug/iroh-do-echo-client" {{quote(E)}} {{quote(TEXT)}} ${net[@]+"${net[@]}"}

# Run any iroh-do-chat subcommand against .demo/endpoint, e.g. `just cli ping`, `just cli chat`.
cli CMD *ARGS: build-demo
    #!/usr/bin/env bash
    set -euo pipefail
    exec "{{run}}" "{{demo_bin}}" {{CMD}} "$(cat "{{demo_dir}}/endpoint")" {{ARGS}}

# Mints a fresh endpoint on admin.localhost (.demo/endpoint.lifecycle). If
# `just local-up` is running, its server is reused, on its port, and its room is
# left alone; otherwise a server is started on LOCAL_PORT and stopped at the end.
# Set LOCAL_PORT if 8787 is taken.
#
# Same bundle in local workerd (wrangler dev): mint, run `lifecycle --local`.
local *ARGS: build
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{demo_dir}}"; chmod 700 "{{demo_dir}}"
    if just _local-up-port >/dev/null 2>&1; then
        port=$(just _local-up-port)
        echo "reusing the local-up server on :$port"
        sleep 2   # let it notice a rebuilt bundle before checking that it answers
        just _local-wait "$port" "{{demo_dir}}/local-up.log" "{{demo_dir}}/local-up.pid"
    else
        port={{local_port}}
        pidf="{{demo_dir}}/wrangler.pid"
        just _local-serve "$port" "{{demo_dir}}/wrangler.log" "$pidf"
        trap 'just _local-stop "'"$pidf"'"' EXIT
    fi
    MINT_APP=chat just _mint "http://admin.localhost:$port" "{{demo_dir}}/admin_token.local" "{{demo_dir}}/endpoint.lifecycle" "--resolve admin.localhost:$port:127.0.0.1"
    "{{run}}" "{{demo_bin}}" --local --local-port "$port" lifecycle "$(cat "{{demo_dir}}/endpoint.lifecycle")" {{ARGS}}

# State persists in .demo/wrangler-state; the log is .demo/local-up.log, the pid
# .demo/local-up.pid. A second call reuses the running server and its room, and
# mints a new room if the state no longer has it. Stop it with `just local-down`.
#
# Start wrangler dev in the background on LOCAL_PORT; keep a room in .demo/endpoint.local.
local-up: build
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{demo_dir}}"; chmod 700 "{{demo_dir}}"
    if port=$(just _local-up-port 2>/dev/null); then
        echo "local-up already running on :$port (pid $(cat "{{demo_dir}}/local-up.pid"))"
        sleep 2
        just _local-wait "$port" "{{demo_dir}}/local-up.log" "{{demo_dir}}/local-up.pid"
    else
        port={{local_port}}
        just _local-serve "$port" "{{demo_dir}}/local-up.log" "{{demo_dir}}/local-up.pid"
        echo "$port" > "{{demo_dir}}/local-up.port"
    fi
    ep="{{demo_dir}}/endpoint.local"
    if [ -s "$ep" ]; then
        # 404: the room is not in this server's state (wiped, or minted elsewhere).
        code=$(curl -s -o /dev/null -w '%{http_code}' --resolve "admin.localhost:$port:127.0.0.1" \
            "http://admin.localhost:$port/status/$(cat "$ep")" || true)
        [ "$code" = "404" ] && { echo "room $(cat "$ep") is not in the local state; minting a new one"; rm -f "$ep"; }
    fi
    if [ ! -s "$ep" ]; then
        MINT_APP=chat MINT_LABEL=local just _mint "http://admin.localhost:$port" "{{demo_dir}}/admin_token.local" "$ep" "--resolve admin.localhost:$port:127.0.0.1"
    fi
    e=$(cat "$ep")
    portenv=""; [ "$port" = "8787" ] || portenv="LOCAL_PORT=$port "
    echo
    echo "room:  $e"
    echo "join:  LOCAL=1 ${portenv}just chat $e <nick>"
    echo "       one terminal per nick; each nick is a separate member"
    echo "stop:  just local-down"

# Stop the server `just local-up` started. Does nothing if none is running.
local-down:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -s "{{demo_dir}}/local-up.pid" ]; then
        just _local-stop "{{demo_dir}}/local-up.pid"
        echo "stopped"
    else
        echo "local-up is not running"
    fi
    rm -f "{{demo_dir}}/local-up.port"

# Prints the port of a running `just local-up`; fails if none is running.
_local-up-port:
    #!/usr/bin/env bash
    set -euo pipefail
    pidf="{{demo_dir}}/local-up.pid"
    [ -s "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null && [ -s "{{demo_dir}}/local-up.port" ]
    cat "{{demo_dir}}/local-up.port"

# Starts wrangler dev on PORT in its own process group, writes the group's pid
# to PIDFILE, and waits until the router answers.
_local-serve PORT LOG PIDFILE:
    #!/usr/bin/env bash
    set -euo pipefail
    # 8787 is wrangler's default port, so another dev server often holds it. Fail
    # early: the readiness loop below would otherwise mint against that server.
    if lsof -nP -iTCP:{{PORT}} -sTCP:LISTEN >/dev/null 2>&1; then
        echo "error: port {{PORT}} is already in use; rerun with LOCAL_PORT=<free port>" >&2; exit 1
    fi
    [ -s "{{demo_dir}}/admin_token.local" ] || (umask 077; openssl rand -hex 32 > "{{demo_dir}}/admin_token.local")
    js="{{bundle_dir}}/index.js"; wasm="{{bundle_dir}}/index_bg.wasm"
    h() { shasum -a 256 "$1" | cut -d' ' -f1; }
    bundle=$(printf '%s%s' "$(h "$js")" "$(h "$wasm")" | shasum -a 256 | cut -d' ' -f1)
    # Secrets via an env file, not argv. PKARR_RELAY empty: never publish localhost URLs.
    (umask 077; printf 'ADMIN_TOKEN=%s\nPKARR_RELAY=\nBUNDLE_SHA256=%s\n' \
        "$(cat "{{demo_dir}}/admin_token.local")" "$bundle" > "{{demo_dir}}/local.env")
    if [ "$(wrangler --version 2>/dev/null || true)" = "{{wrangler_version}}" ]; then w=(wrangler); else w=(npx --yes "wrangler@{{wrangler_version}}"); fi
    # Job control puts the server in its own process group, so stopping it
    # also stops the workerd processes wrangler spawns.
    set -m
    (cd "{{root}}/harness/workerd" && CI=1 exec nohup "${w[@]}" dev --local --ip 127.0.0.1 --port {{PORT}} --inspector-port $(({{PORT}} + 1000)) \
        --env-file "{{demo_dir}}/local.env" --persist-to "{{demo_dir}}/wrangler-state" \
        --show-interactive-dev-session=false) < /dev/null > "{{LOG}}" 2>&1 &
    wpid=$!
    set +m
    echo "$wpid" > "{{PIDFILE}}"
    echo "wrangler dev (pid $wpid) starting on :{{PORT}}; log: {{LOG}}"
    just _local-wait {{PORT}} "{{LOG}}" "{{PIDFILE}}" || { just _local-stop "{{PIDFILE}}"; exit 1; }

# Waits until the server in PIDFILE answers on PORT. A running server reloads
# when the bundle changes, so this is also needed before reusing one.
_local-wait PORT LOG PIDFILE:
    #!/usr/bin/env bash
    set -euo pipefail
    pid=$(cat "{{PIDFILE}}")
    for i in $(seq 1 60); do
        kill -0 "$pid" 2>/dev/null || { echo "wrangler dev exited:" >&2; tail -40 "{{LOG}}" >&2; exit 1; }
        code=$(curl -s -o /dev/null -w '%{http_code}' --resolve "admin.localhost:{{PORT}}:127.0.0.1" \
            "http://admin.localhost:{{PORT}}/mint" || true)
        [ "$code" != "000" ] && exit 0
        sleep 1
    done
    echo "wrangler dev did not answer on :{{PORT}} within 60 s; log: {{LOG}}" >&2
    exit 1

# Stops the process group whose leader's pid is in PIDFILE, then removes PIDFILE.
_local-stop PIDFILE:
    #!/usr/bin/env bash
    set -uo pipefail
    pid=$(cat "{{PIDFILE}}" 2>/dev/null || true)
    if [ -n "$pid" ]; then
        kill -TERM -- "-$pid" 2>/dev/null || true
        for i in $(seq 1 20); do pgrep -g "$pid" >/dev/null || break; sleep 0.25; done
        kill -KILL -- "-$pid" 2>/dev/null || true
    fi
    rm -f "{{PIDFILE}}"

# Build, sign, notarize, tag and publish iroh-do-chat VERSION for macOS (scripts/release-macos.sh).
release VERSION:
    "{{root}}/scripts/release-macos.sh" {{quote(VERSION)}}

# Build, sign and package iroh-do-chat VERSION into dist/, without notarizing or publishing.
release-dry VERSION:
    "{{root}}/scripts/release-macos.sh" {{quote(VERSION)}} --dry

# tofu plan; prints "zero diff" when there are no changes, as expected after `up`.
plan:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${CLOUDFLARE_API_TOKEN:?export CLOUDFLARE_API_TOKEN first}"
    export TF_VAR_admin_token="$(cat "{{demo_dir}}/admin_token")"
    export TF_VAR_state_passphrase="$(cat "{{demo_dir}}/state_passphrase")"
    tofu -chdir="{{infra}}" plan -input=false -detailed-exitcode && echo "zero diff" || {
        rc=$?; [ $rc -eq 2 ] && echo "plan has changes (exit 2)" >&2; exit $rc; }

# tofu destroy after typed confirmation. Deletes every endpoint identity with the script.
down:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${CLOUDFLARE_API_TOKEN:?export CLOUDFLARE_API_TOKEN first}"
    export TF_VAR_admin_token="$(cat "{{demo_dir}}/admin_token")"
    export TF_VAR_state_passphrase="$(cat "{{demo_dir}}/state_passphrase")"
    script=$(tofu -chdir="{{infra}}" output -raw script_name 2>/dev/null || echo iroh-do)
    suffix=$(tofu -chdir="{{infra}}" output -raw zone_suffix 2>/dev/null || echo "?")
    cat >&2 <<EOF

    WARNING: this deletes the Worker script "$script". Cloudflare deletes the
    Durable Object namespace with it, and with it EVERY endpoint identity
    (secret key) stored under *.$suffix. There is no export and no undo:
    re-applying creates a new, empty namespace, and every previously minted
    EndpointId becomes permanently unreachable (spec §13.1 R2, V19).

    Also removed: the wildcard DNS record, the Workers route and the ACM
    certificate pack. NOT removed: the zone's ACM subscription (billing).

    EOF
    read -r -p "Type 'destroy $script' to continue: " answer
    [ "$answer" = "destroy $script" ] || { echo "aborted" >&2; exit 1; }
    tofu -chdir="{{infra}}" destroy -input=false -auto-approve
    rm -f "{{demo_dir}}/endpoint"
    echo "destroyed. .demo/admin_token and .demo/state_passphrase kept (delete them by hand)."

# tofu fmt -check + validate (no credentials needed).
infra-check:
    #!/usr/bin/env bash
    set -euo pipefail
    export TF_VAR_state_passphrase="${TF_VAR_state_passphrase:-validate-only-not-a-secret}"
    tofu -chdir="{{infra}}" fmt -check -recursive
    tofu -chdir="{{infra}}" init -input=false -backend=false >/dev/null
    tofu -chdir="{{infra}}" validate

# POST /mint. Usage: _mint <admin-url> <token-file> <out-file> [extra curl args]
_mint ADMIN TOKEN_FILE OUT CURL_EXTRA="":
    #!/usr/bin/env bash
    set -euo pipefail
    [ -s "{{TOKEN_FILE}}" ] || { echo "error: {{TOKEN_FILE}} missing (run just up / just local)" >&2; exit 1; }
    # Token goes to curl on stdin (-K -), never on argv. The optional label
    # (MINT_LABEL) and app (MINT_APP) are JSON-encoded by node, so any text is safe.
    body=$(MINT_APP="${MINT_APP:-}" MINT_LABEL="${MINT_LABEL:-}" node -e 'const a=process.env.MINT_APP,l=process.env.MINT_LABEL,o={};if(a)o.app=a;if(l)o.label=l;process.stdout.write(Object.keys(o).length?JSON.stringify(o):"")')
    resp=$(printf 'header = "Authorization: Bearer %s"\n' "$(cat "{{TOKEN_FILE}}")" \
        | curl -fsS -K - {{CURL_EXTRA}} -H 'Content-Type: application/json' --data-binary "$body" -X POST "{{ADMIN}}/mint")
    id=$(printf '%s' "$resp" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const r=JSON.parse(s);if(!/^[ybndrfg8ejkmcpqxot1uwisza345h769]{52}$/.test(r.id))process.exit(1);console.log(r.id)})')
    url=$(printf '%s' "$resp" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s).relay_url))')
    published=$(printf '%s' "$resp" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s).published))')
    app=$(printf '%s' "$resp" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(JSON.parse(s).app))')
    printf '%s\n' "$id" > "{{OUT}}"
    echo "E          = $id"
    echo "app        = $app"
    echo "relay URL  = $url"
    echo "published  = $published (pkarr, note 004)"
    echo "saved to {{OUT}}"
