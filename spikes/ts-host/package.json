{
  "name": "iroh-do-ts-host-spike",
  "private": true,
  "type": "module",
  "description": "Spike: an iroh-do endpoint as an idiomatic TypeScript Durable Object over a wasm library",
  "scripts": {
    "build:wasm": "./build-wasm.sh",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port ${LOCAL_PORT:-8799} --inspector-port 9799",
    "test:evict": "node test/evict-test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.130.0"
  }
}
