{
  "name": "history-and-since",
  "description": "/history returns the newest n room events oldest first, /since the events after a seq. Both mark events hist:true. Bad arguments get a usage error.",
  "members": [
    "ana",
    "bo",
    "cy"
  ],
  "steps": [
    {
      "member": "ana",
      "send": "/join ana\n",
      "expect": [
        {
          "t": "join",
          "seq": 1,
          "prev": 0,
          "ts": {
            "$any": "ts"
          },
          "peer": {
            "$ref": "peer:ana"
          },
          "nick": "ana",
          "hist": true
        },
        {
          "t": "ready",
          "room": {
            "$ref": "room"
          },
          "you": {
            "peer": {
              "$ref": "peer:ana"
            },
            "nick": "ana"
          },
          "last_seq": 1
        }
      ]
    },
    {
      "member": "ana",
      "send": "/say one\n",
      "expect": [
        {
          "t": "ok",
          "seq": 2,
          "prev": 1
        }
      ]
    },
    {
      "member": "ana",
      "note": "captures the seq of the second message",
      "expect": [
        {
          "t": "ok",
          "seq": {
            "$capture": "two",
            "as": "int"
          },
          "prev": 2
        }
      ],
      "send": "/say two\n"
    },
    {
      "member": "ana",
      "send": "/say three\n",
      "expect": [
        {
          "t": "ok",
          "seq": 4,
          "prev": 3
        }
      ]
    },
    {
      "member": "bo",
