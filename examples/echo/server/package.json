{
  "name": "iroh-do-echo-server",
  "private": true,
  "type": "module",
  "description": "The echo app as a TypeScript Durable Object on iroh-do",
  "exports": {
    ".": "./src/echo.ts"
  },
  "dependencies": {
    "iroh-do": "0.1.0"
  },
  "devDependencies": {
    "iroh-do-testing": "0.1.0"
  },
  "scripts": {
    "build": "iroh-do-bundle --config wrangler.toml --outdir dist",
    "types": "wrangler types",
    "check": "npm run types && tsc --noEmit",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port ${LOCAL_PORT:-8799} --inspector-port $((${LOCAL_PORT:-8799} + 1000))",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test": "npm run test:unit && npm run test:e2e"
  }
}
