# Optional shared backend on Cloudflare R2 (S3-compatible). Copy to
# examples/deployment/infra/backend.tf, create the bucket and an R2 access key, then:
#   export AWS_ACCESS_KEY_ID=... AWS_SECRET_ACCESS_KEY=...
#   tofu init -migrate-state
# State stays client-side encrypted (encryption.tf); R2 only ever sees ciphertext.
terraform {
  backend "s3" {
    bucket = "iroh-do-tfstate"
    key    = "iroh-do/terraform.tfstate"
    region = "auto"
    endpoints = {
      s3 = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
    }
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_s3_checksum            = true
    use_path_style              = true
  }
}
