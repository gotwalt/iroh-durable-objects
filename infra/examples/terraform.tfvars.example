# Copy to infra/<name>.auto.tfvars (gitignored) and fill in. Never commit real ids
# alongside a token, and never put the API token or admin token here:
#   - CLOUDFLARE_API_TOKEN comes from the environment,
#   - admin_token comes from TF_VAR_admin_token (`just up` generates it),
#   - state_passphrase comes from TF_VAR_state_passphrase (`just up` generates it).

account_id = "0123456789abcdef0123456789abcdef"
zone_id    = "0123456789abcdef0123456789abcdef"
zone_name  = "example.com"

# Endpoints: https://<E>.iroh-do.example.com/   Admin: https://admin.iroh-do.example.com
# hostname_prefix = "iroh-do"

# worker_bundle_dir     = "../build/worker"
# compatibility_date    = "2026-09-15"
# certificate_authority = "lets_encrypt"
